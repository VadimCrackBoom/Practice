<Window x:Class="todo.LogIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:todo"
        mc:Ignorable="d"
        Title="LogIn" Height="600" Width="800" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" MinWidth="800" MinHeight="600">
    <Window.Resources>
        <ResourceDictionary Source="Dictionary.xaml"/>
    </Window.Resources>
    <Grid Height="600" Width="800">
        <Image Height="150" Margin="51,42,593,0" VerticalAlignment="Top" Source="/logo.png"/>
        <WrapPanel Margin="430,80,47,93">
            <Label Content="Добро пожаловать!" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Height="50" FontSize="30" Margin="0,0,0,60" FontFamily="{StaticResource ActorFont}"/>
            <Label x:Name="statusLabel" Content="Label" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Red" Width="300" HorizontalContentAlignment="Center" Visibility="Hidden"/>
            <Label Content="Почта" FontSize="20" Height="43" Width="201" FontFamily="{StaticResource ActorFont}"/>
            <TextBox x:Name="emailTB" Style="{StaticResource TextBoxStyle}" Text="Введите почту" Tag="Введите почту" LostFocus="AddText" GotFocus="RemoveText"/>
            <Label Content="Пароль" FontSize="20" Height="38" Width="179" Margin="0,0,0,10" FontFamily="{StaticResource ActorFont}"/>
            <TextBox x:Name="passwordTB" Style="{StaticResource TextBoxStyle}" Text="Введите пароль" Tag="Введите пароль" LostFocus="AddText" GotFocus="RemoveText"/>
            <Label Content="Восстановить пароль" FontSize="20" Height="43" Width="204" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="80,0,0,0" FontFamily="{StaticResource ActorFont}"/>
            <Button x:Name="Primary_Button" Style="{StaticResource PrimaryButtonStyle}" Content="Войти" Click="Button_Click_1"/>
            <Button x:Name="Secondary_Button" Style="{StaticResource SecondaryButtonStyle}" Content="Регистрация" Click="Button_Click"/>
        </WrapPanel>
    </Grid>
</Window>