<Page x:Class="todo.View.LogIn"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:todo.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LogIn" ShowsNavigationUI="False">

    <Page.Resources>
        <ResourceDictionary Source="pack://application:,,,/todo;component/Dictionary.xaml"/>
    </Page.Resources>

    <Grid Height="450" Width="800" Background="White">
        <Label x:Name="statusLabel" Content="Label" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Red" Width="300" HorizontalContentAlignment="Center" Visibility="Hidden"/>
        <!-- Логотип -->
        <Image Height="150" Margin="51,42,593,0" VerticalAlignment="Top" Source="/logo.png"/>

        <!-- Заголовок -->
        <Label Content="Добро пожаловать!" 
               HorizontalAlignment="Left" 
               VerticalAlignment="Top" 
               Width="300" 
               Height="50" 
               FontSize="30" 
               Margin="430,80,0,0" 
               FontFamily="{StaticResource ActorFont}"/>

        <!-- Поле для почты -->
        <Label Content="Почта" 
               HorizontalAlignment="Left" 
               VerticalAlignment="Top" 
               FontSize="20" 
               Height="43" 
               Width="201" 
               Margin="430,150,0,0" 
               FontFamily="{StaticResource ActorFont}"/>
        <TextBox x:Name="emailTB" 
                 Style="{StaticResource TextBoxStyle}" 
                 Text="Введите почту" 
                 Tag="Введите почту" 
                 LostFocus="AddText" 
                 GotFocus="RemoveText" 
                 Margin="430,190,0,0" 
                 VerticalAlignment="Top" 
                 HorizontalAlignment="Left"/>

        <!-- Поле для пароля -->
        <Label Content="Пароль" 
               HorizontalAlignment="Left" 
               VerticalAlignment="Top" 
               FontSize="20" 
               Height="38" 
               Width="179" 
               Margin="430,230,0,0" 
               FontFamily="{StaticResource ActorFont}"/>
        <TextBox x:Name="passwordTB" 
                 Style="{StaticResource TextBoxStyle}" 
                 Text="Введите пароль" 
                 Tag="Введите пароль" 
                 LostFocus="AddText" 
                 GotFocus="RemoveText" 
                 Margin="430,270,0,0" 
                 VerticalAlignment="Top" 
                 HorizontalAlignment="Left"/>

        <!-- Кнопка "Войти" -->
        <Button x:Name="Primary_Button" 
                Style="{StaticResource PrimaryButtonStyle}" 
                Content="Войти" 
                Click="Button_Click_1" 
                Margin="430,338,0,0" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Left"/>

        <!-- Ссылка "Восстановить пароль" -->
        <Label Content="Восстановить пароль" 
               HorizontalAlignment="Left" 
               VerticalAlignment="Top" 
               FontSize="20" 
               Height="43" 
               Width="204" 
               Margin="430,295,0,0" 
               FontFamily="{StaticResource ActorFont}"/>

        <!-- Кнопка "Регистрация" -->
        <Button x:Name="Secondary_Button" 
                Style="{StaticResource SecondaryButtonStyle}" 
                Content="Регистрация" 
                Click="Button_Click" 
                Margin="430,383,0,0" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Left"/>
    </Grid>
</Page>