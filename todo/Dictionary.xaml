<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Шрифты -->
    <FontFamily x:Key="ActorFont">pack://application:,,,/todo;component/Fonts/#Actor</FontFamily>

    <!-- Цвета -->
    <SolidColorBrush x:Key="PrimaryButtonBackground" Color="#FFF96060"/>
    <SolidColorBrush x:Key="PrimaryButtonForeground" Color="White"/>
    <SolidColorBrush x:Key="SecondaryButtonBackground" Color="#FFF96060"/>
    <SolidColorBrush x:Key="SecondaryButtonForeground" Color="White"/>
    <SolidColorBrush x:Key="CheckBoxStrokeColor" Color="#6074F9"/>
    <SolidColorBrush x:Key="CheckBoxCheckedColor" Color="#FFF96060"/>
    <SolidColorBrush x:Key="CheckBoxDisabledColor" Color="LightGray"/>
    <SolidColorBrush x:Key="SelectedItemBackground" Color="#EEEDFF"/>
    <!-- Цвет для выделенных элементов по умолчанию -->
    <SolidColorBrush x:Key="SelectedItemForeground" Color="Black"/>
    <SolidColorBrush x:Key="TransparentBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="CreatedTaskBackground" Color="#EEEDFF"/>
    <!-- Цвет для созданных задач -->
    <SolidColorBrush x:Key="CompletedTaskBackground" Color="#E7FFED"/>
    <!-- Цвет для завершённых задач -->
    <SolidColorBrush x:Key="CompletedTaskForeground" Color="Gray"/>
    <!-- Цвет текста для завершённых задач -->
    <SolidColorBrush x:Key="CreatedTaskForeground" Color="Black"/>
    <!-- Цвет текста для созданных задач -->

    <!-- Стили для текстовых полей -->
    <Style x:Key="TextBoxStyle" TargetType="TextBox">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveBorderColorKey}}"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стили для кнопок -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryButtonBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryButtonForeground}"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="FontFamily" Value="{StaticResource ActorFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="20,20,5,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SecondaryButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SecondaryButtonBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryButtonForeground}"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{StaticResource ActorFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="5,5,20,20">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для кнопки "Назад" -->
    <Style x:Key="BackButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Content" Value="Назад"/>
    </Style>

    <!-- Стиль для кнопки "Зарегистрироваться" -->
    <Style x:Key="RegisterButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Content" Value="Зарегистрироваться"/>
    </Style>

    <!-- Стиль для круглой кнопки "+" -->
    <Style x:Key="RoundButtonStyle" TargetType="Button">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFFB6B6" Offset="1"/>
                    <GradientStop Color="#FFF96060" Offset="0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontFamily" Value="{StaticResource ActorFont}"/>
        <Setter Property="Width" Value="76"/>
        <Setter Property="Height" Value="76"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="40">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для кнопки "Создать первую задачу" -->
    <Style x:Key="CreateTaskButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryButtonBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryButtonForeground}"/>
        <Setter Property="Content" Value="Создать первую задачу"/>
        <Setter Property="Width" Value="204"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="300,0,0,0"/>
        <Setter Property="FontFamily" Value="{StaticResource ActorFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="5,5,5,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для кнопки "Готово" -->
    <Style x:Key="OkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryButtonBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryButtonForeground}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{StaticResource ActorFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="20,20,5,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для кнопки "Удалить" -->
    <Style x:Key="DeleteButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SecondaryButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SecondaryButtonBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryButtonForeground}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{StaticResource ActorFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="5,5,20,20">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для ListBoxItem (по умолчанию) -->
    <Style x:Key="ListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Border" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="5"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource SelectedItemBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource SelectedItemForeground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter Property="Background" Value="{StaticResource TransparentBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для ListBoxItem (созданные задачи) -->
    <Style x:Key="CreatedTaskItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemStyle}">
        <Setter Property="Foreground" Value="{StaticResource CreatedTaskForeground}"/>
        <!-- Чёрный текст -->
        
        <Setter Property="Background" Value="{StaticResource CreatedTaskBackground}"/>
        <!-- Фон для созданных задач -->
    </Style>

    <!-- Стиль для ListBoxItem (завершённые задачи) -->
    <Style x:Key="CompletedTaskItemStyle" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Border" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="5"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource CompletedTaskBackground}"/>
                            <!-- Фон для завершённых задач -->
                            
                            <Setter Property="Foreground" Value="{StaticResource CompletedTaskForeground}"/>
                            <!-- Серый текст -->
                            
                            <Setter Property="TextBlock.TextDecorations" Value="Strikethrough"/>
                            <!-- Зачёркнутый текст -->
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter Property="Background" Value="{StaticResource TransparentBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для CheckBox -->
    <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Ellipse x:Name="Ellipse" Fill="Transparent" Stroke="{StaticResource CheckBoxStrokeColor}" StrokeThickness="3" Width="15" Height="15" Margin="0,15,0,0"/>
                        <Path x:Name="CheckMark" Data="M2,6 L7,11 L13,3" Stroke="White" StrokeThickness="2" Visibility="Collapsed" Margin="0,15,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ellipse" Property="Stroke" Value="{StaticResource CheckBoxCheckedColor}" />
                            <Setter TargetName="Ellipse" Property="Fill" Value="{StaticResource CheckBoxCheckedColor}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ellipse" Property="Stroke" Value="{StaticResource CheckBoxDisabledColor}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>