<Window x:Class="todo.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:todo"
        mc:Ignorable="d"
        Title="Main" Height="600" Width="800" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" MinWidth="800" MinHeight="600" Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary Source="Dictionary.xaml"/>
    </Window.Resources>
    <Grid Height="600" Width="800">
        <Image HorizontalAlignment="Left" Height="76" VerticalAlignment="Top" Width="76" Source="/profilicon.png" Margin="10,10,0,0"/>
        <ListBox x:Name="HistoryListBox" Margin="158,126,323,50" BorderBrush="White" BorderThickness="2" Visibility="Visible" SelectionChanged="HistoryListBox_SelectionChanged" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource ListBoxItemStyle}"/>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="5,-9,5,0" IsChecked="{Binding IsCompleted}" Style="{StaticResource CheckBoxStyle}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontSize="16" Foreground="Gray" TextDecorations="Strikethrough" Margin="8,0,0,0" Width="240"/>
                                <TextBlock Text="{Binding DueDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="14" Foreground="Gray" TextDecorations="Strikethrough" Margin="20,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ListBox x:Name="taskListBox" SelectionChanged="taskListBox_SelectionChanged" Margin="158,126,323,50" BorderBrush="White" Visibility="Collapsed">
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource ListBoxItemStyle}"/>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel MouseDown="StackPanel_MouseDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="5,0" IsChecked="{Binding IsCompleted}" Style="{StaticResource CheckBoxStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="16"/>
                        </Grid>
                        <TextBlock Text="{Binding DueDate, StringFormat='{}{0:dd.MM.yyyy}'}" Margin="35,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Круглая кнопка "+" -->
        <Button x:Name="Added_task" Style="{StaticResource RoundButtonStyle}" Content="+" Margin="30,470,674,38" Click="Button_Click"/>

        <!-- Остальные элементы -->
        <Label Content="Дом" HorizontalAlignment="Left" Margin="158,66,0,0" VerticalAlignment="Top" FontSize="18" Background="{x:Null}" Foreground="#FF72D600" FontFamily="{StaticResource ActorFont}"/>
        <Label Content="Работа" HorizontalAlignment="Left" Margin="237,66,0,0" VerticalAlignment="Top" FontSize="18" Background="{x:Null}" Foreground="#FFFF5D00" FontFamily="{StaticResource ActorFont}"/>
        <Label Content="Учёба" HorizontalAlignment="Left" Margin="325,66,0,0" VerticalAlignment="Top" FontSize="18" Background="{x:Null}" Foreground="#FF004AC3" FontFamily="{StaticResource ActorFont}"/>
        <Label Content="Отдых" HorizontalAlignment="Left" Margin="415,66,0,0" VerticalAlignment="Top" FontSize="18" Background="{x:Null}" Foreground="#FFB700FF" FontFamily="{StaticResource ActorFont}"/>
        <Label x:Name="History_Label" Content="История" HorizontalAlignment="Left" Margin="22,205,0,0" VerticalAlignment="Top" FontSize="18" Background="{x:Null}" Foreground="#FF754600" FontFamily="{StaticResource ActorFont}" MouseDown="History_Label_MouseDown"/>
        <Label x:Name="Tasks" Content="Задачи" HorizontalAlignment="Left" Margin="20,150,0,0" VerticalAlignment="Top" FontSize="18" Background="{x:Null}" Foreground="#FF754600" FontFamily="{StaticResource ActorFont}" MouseDown="Tasks_Label_MouseDown"/>
        <ListBox x:Name="DescriptionListBox" Margin="501,90,10,50" BorderBrush="Black" BorderThickness="2,2,2,2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="taskTitleTextBlock" FontSize="24" TextAlignment="Center" Margin="0,10,0,15" Width="270"/>
            <TextBlock x:Name="taskDueDateTextBlock" FontSize="16" Width="270" Margin="0,10,0,0" TextAlignment="Left"/>
            <TextBlock x:Name="taskDescriptionTextBlock" TextWrapping="Wrap" Margin="0,10,0,0" Width="270" TextAlignment="Left"/>
        </ListBox>
        <Button x:Name="okButton" Style="{StaticResource OkButtonStyle}" Content="Готово" Margin="522,350,32,210" Click="okButton_Click" Visibility="Collapsed"/>
        <Button x:Name="deleteButton" Style="{StaticResource DeleteButtonStyle}" Content="Удалить" Margin="522,397,32,163" Click="deleteButton_Click" Visibility="Collapsed"/>
        <TextBlock Text="{Binding Name}" x:Name="username" HorizontalAlignment="Left" Margin="7,94,0,0" TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Center" FontSize="16" Width="82"/>
    </Grid>
</Window>