<Window x:Class="todo.MainEmpty"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:todo"
        mc:Ignorable="d"
        Title="MainEmpty" Height="600" WindowStartupLocation="CenterScreen" Width="800" MinWidth="800" MinHeight="600">
    <Window.Resources>
        <ResourceDictionary Source="Dictionary.xaml"/>
    </Window.Resources>
    <Grid Width="800" Height="600">
        <WrapPanel>
            <Image HorizontalAlignment="Center" Height="76" VerticalAlignment="Top" Width="76" Source="/profilicon.png" Margin="10,10,0,0"/>
            <Label Content="Добро пожаловать!" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="36" Margin="20,100,0,0" FontFamily="{StaticResource ActorFont}"/>
            <Label Content="Создайте свою первую задачу" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="36" Margin="105,50,0,50" FontFamily="{StaticResource ActorFont}"/>
            <Button x:Name="CreateTaskButton" Style="{StaticResource CreateTaskButtonStyle}" Click="Button_Click"/>
        </WrapPanel>
    </Grid>
</Window>